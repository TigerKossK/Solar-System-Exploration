# Normalise line endings to LF everywhere.
#
# planet/*.html is generated by scripts/build-planets.js (Node, which always
# writes LF) and the CI drift check compares the runner's freshly generated
# output against what is committed. Without this file that comparison silently
# depends on each contributor's core.autocrlf setting: one commit made with
# CRLF working-tree files would make every line of that page appear changed.
* text=auto eol=lf

# Windows batch files must keep CRLF. cmd.exe mis-parses LF-only files around
# multi-line blocks — exactly what serve.bat's `if errorlevel 1 ( ... )` is —
# and the rule above would otherwise lock them to LF permanently.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
